# Copy to .env and fill in. .env is gitignored. Never commit real values.
# Nothing here is needed for the tests, the demo or the attack suite.

# ---- who the agents act for (stands in for a login) -------------------------
# tkim = engineer, pnair = operator, jchen = admin
FDE_USER=pnair

# ---- which model drives the agents (see agents/models.py) -------------------
#   litellm:openai/fde-router   local LiteLLM router from config.yaml (Ollama, Gemini fallback)
#   litellm:openai/fde-gemini   hosted Gemini through the same router
#   gemini-2.5-flash            Gemini directly: API key, or Vertex AI if enabled below
FDE_MODEL=litellm:openai/fde-router

# ---- how the gateway is wired in (see agents/wiring.py) ---------------------
#   direct | guard | mcp
FDE_TOOLS=direct

# ---- Gemini with an API key (Google AI Studio) ------------------------------
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# ---- Gemini on Vertex AI (Google Cloud) -------------------------------------
# Set the first line to TRUE to use Vertex AI instead of the API key, after:
#   gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global

# ---- LiteLLM router (only for the litellm: models) --------------------------
LITELLM_MASTER_KEY=REPLACE_WITH_ANY_LOCAL_SECRET

# ---- Cloud Run deploy (deploy/cloudrun.sh); all optional --------------------
# FDE_RUN_REGION=us-central1
# FDE_SERVICE=agent-gateway
# FDE_DEPLOY_MODEL=gemini-3-flash-preview
# FDE_DEPLOY_LOCATION=global            Vertex AI location for the deployed service
# FDE_DEPLOY_USER=pnair
